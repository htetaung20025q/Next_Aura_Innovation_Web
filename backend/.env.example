# Next Aura INNOVATION - Backend Environment Configuration

# Application Settings
PROJECT_NAME="Next Aura INNOVATION"
ENVIRONMENT="development" # Set to "production" in live deployment
DEBUG=True                 # Set to False in production
API_PREFIX="/api"

# CORS Configuration
# In production, specify exact custom domains:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
# Regex to match all Vercel deployment URLs and previews:
CORS_ORIGIN_REGEX="^https:\/\/(?:[a-zA-Z0-9-]+\.)*vercel\.app$"

# PostgreSQL Database Configuration
# In production (e.g. Supabase, Neon, Railway, AWS RDS), use DATABASE_URL:
# DATABASE_URL="postgresql+psycopg2://user:password@host:5432/dbname"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="next_aura_db"

# Security & Authentication
# In production: generate a high-entropy secret (e.g. `openssl rand -hex 32`)
SECRET_KEY="dev-secret-key-change-in-production-next-aura-innovation-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Bootstrap Credentials (created automatically on startup if database is empty)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="NextAura2026!Secure"
ADMIN_EMAIL="admin@nextaurainnovation.com"

# Media Storage Configuration
# Set to "local" for local disk (default), or "s3" for AWS S3 / Cloudflare R2 / Supabase Storage
MEDIA_STORAGE_PROVIDER="local"

# Optional public CDN base URL (e.g. "https://cdn.nextaura.io" or "https://pub-xxx.r2.dev")
# MEDIA_BASE_URL="https://cdn.nextaura.io"

# Production Object Storage Settings (Required when MEDIA_STORAGE_PROVIDER is "s3" or "r2")
# S3_BUCKET_NAME="nextaura-media"
# S3_ENDPOINT_URL="https://<accountid>.r2.cloudflarestorage.com" # For Cloudflare R2 or MinIO
# S3_REGION_NAME="us-east-1"
# S3_ACCESS_KEY_ID="your_s3_or_r2_access_key"
# S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_key"
# S3_PUBLIC_URL_PREFIX="https://media.nextaura.io"
